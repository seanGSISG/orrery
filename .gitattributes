* text=auto eol=lf

# Binary source assets live in Git LFS.
assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/**/*.exr  filter=lfs diff=lfs merge=lfs -text
assets/**/*.hdr  filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav  filter=lfs diff=lfs merge=lfs -text
assets/**/*.ogg  filter=lfs diff=lfs merge=lfs -text
assets/**/*.flac filter=lfs diff=lfs merge=lfs -text
assets/**/*.ttf  filter=lfs diff=lfs merge=lfs -text
assets/**/*.otf  filter=lfs diff=lfs merge=lfs -text
*.blend          filter=lfs diff=lfs merge=lfs -text

# Baked lightmaps (`just bake`). Their .import files and .sha256 sidecars stay plain text.
game/levels/lightmaps/*.exr    filter=lfs diff=lfs merge=lfs -text
game/levels/lightmaps/*.png    filter=lfs diff=lfs merge=lfs -text
game/levels/lightmaps/*.lmbake filter=lfs diff=lfs merge=lfs -text

# Baked tier skies (`just bake-skies`). Their .import files stay plain text.
game/skies/*.hdr               filter=lfs diff=lfs merge=lfs -text
