[gd_resource type="ShaderMaterial" format=3]

; Brass study, lever: base texture. ambientCG Metal048C (rough, impure gold): its large blotches
; vary about half as much as those of Metal007, so a narrow bar shows less grain. Metallic 1.
; Tint gives the albedo of the "bright" variant, about sRGB (222, 186, 108). Median roughness
; 0.271 x 1.59 = 0.43: at or above 0.4, so faces that look up at a blue sky do not turn olive.

[ext_resource type="Shader" path="res://materials/kit_surface.gdshader" id="1"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-JPG_Color.jpg" id="2"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-JPG_Roughness.jpg" id="3"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-PNG_NormalGL.png" id="4"]

