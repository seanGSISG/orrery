[gd_resource type="ShaderMaterial" format=3]

; Kit brass of set A (docs/design/visual-quality.md §10): ambientCG Metal048C, the `metal048c`
; variant of the brass study, which Sean picked on 2026-11-22. Its colour blotches vary about
; half as much as those of Metal007, so a narrow bar reads as metal, not as wood or cork. Metallic 1.
; Tinted albedo about sRGB (222, 186, 108). Roughness 0.271 x 1.59 = 0.43: at or above 0.4, so
; faces that look up at a blue sky do not turn olive. Polished brass and gold stay on Metal048A.

[ext_resource type="Shader" path="res://materials/kit_surface.gdshader" id="1"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-JPG_Color.jpg" id="2"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-JPG_Roughness.jpg" id="3"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal048C_2K-PNG_NormalGL.png" id="4"]

[resource]
shader = ExtResource("1")
shader_parameter/albedo_map = ExtResource("2")
shader_parameter/roughness_map = ExtResource("3")
shader_parameter/normal_map = ExtResource("4")
shader_parameter/tint = Vector3(0.764, 0.665, 0.471)
shader_parameter/tile = 2.0
shader_parameter/roughness_scale = 1.59
shader_parameter/metallic = 1.0
shader_parameter/detail_tile = 0.25
