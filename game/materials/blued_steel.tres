[gd_resource type="ShaderMaterial" format=3]

; Blued steel (Ascent 2: the mainspring, the clock hands, the hour marks of the Dial ring): the
; dark bronze Metal008, tinted to a deep blue. The tint takes the map's median from sRGB
; (172, 131, 102) to about (80, 115, 195), so the brightest channel keeps the metal floor of
; docs/design/visual-quality.md §6 (180 or more) and red and green stay low.

[ext_resource type="Shader" path="res://materials/kit_surface.gdshader" id="1"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal008_2K-JPG_Color.jpg" id="2"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal008_2K-JPG_Roughness.jpg" id="3"]
[ext_resource type="Texture2D" path="res://materials/textures/Metal008_2K-PNG_NormalGL.png" id="4"]

[resource]
shader = ExtResource("1")
shader_parameter/albedo_map = ExtResource("2")
shader_parameter/roughness_map = ExtResource("3")
shader_parameter/normal_map = ExtResource("4")
shader_parameter/tint = Vector3(0.19, 0.76, 4.1)
shader_parameter/tile = 1.5
shader_parameter/roughness_scale = 1.3
shader_parameter/metallic = 1.0
shader_parameter/normal_strength = 0.5
