; Orrery Godot project. See docs/plan.md §3 and §4.
config_version=5

[application]

config/name="Orrery"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[autoload]

InputHub="*res://core/input/input_hub.gd"
Game="*res://core/game.gd"
Save="*res://core/save/save.gd"
Graphics="*res://settings/graphics.gd"
Music="*res://audio/music.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_void_return=2

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/lightmap_baker/plugin.cfg")

[input]

roll_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":1,"axis_value":-1.0,"script":null)
]
}
roll_back={
